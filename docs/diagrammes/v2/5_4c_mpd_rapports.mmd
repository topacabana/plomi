  }
  documents {
    uuid id PK
    uuid mandate_id FK
    uuid report_id FK
    document_type document_type
    text file_path
    uuid uploaded_by_user_id FK
  }
  destructive_consents {
    uuid id PK
    uuid mandate_id FK
    uuid expert_id FK
    text signatory_name
    text signatory_role
    text works
    text consent_version
    timestamptz consented_at
  }
