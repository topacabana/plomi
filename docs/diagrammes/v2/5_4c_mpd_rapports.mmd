erDiagram
  mandates {
    uuid id PK
  }
  experts {
    uuid id PK
  }
  rdf_reports {
    uuid id PK
    uuid mandate_id FK
    uuid created_by
    varchar status
    text_array hypotheses
    text rapport_conclusions
    timestamptz submitted_at
    text pdf_url
  }
  rdf_report_rooms {
    uuid id PK
    uuid report_id FK
    uuid mandate_id FK
    smallint step
    text room
    boolean infiltration
    text_array photos
  }
  report_media {
    uuid id PK
    uuid mandate_id FK
    uuid expert_id FK
    text media_type
    text file_url
    numeric target_x
    numeric target_y
