@startuml
!include _style.iuml
title SEQ-02 — Prise en charge, intervention et envoi du rapport
actor "Expert" as E
participant "WeWeb" as W
database "PostgreSQL" as DB
participant "Storage\nprivé" as ST
participant "Edge\nPDF" as PDF
actor "Gestionnaire" as G
actor "Bénéficiaire" as B

E -> W : touche un marqueur de la carte
W --> E : popup (créneau, « Itinéraire GPS »,\n« Prendre en charge »)
E -> W : choisit un créneau, « Prendre en charge »
W -> DB : rpc expert_claim_mandate(mandat, créneau)
DB -> DB : contrôles (CGU acceptées, liste ciblée, statut)\ndropped → assigned
alt mandat déjà pris
  DB --> W : erreur
  W --> E : « Ce mandat n'est plus disponible »
else succès
  DB --> W : ok
  W --> E : « Mandats à traiter en priorité »
end
== Vérification de présence (sur place) ==
alt le bénéficiaire a une adresse e-mail
  E -> W : « Envoyer le code »
  W -> DB : presence_code_issue (via Edge Function, e-mail Brevo)
  DB --> B : code à 6 chiffres (valable 30 min, 3 envois max)
  B --> E : lit le code à l'expert
  E -> W : saisit le code
  W -> DB : rpc presence_code_check
  alt 5e code faux
    DB -> G : notification « vérification bloquée »
    DB --> W : bloqué : contacter le gestionnaire
  else code juste
    DB -> DB : presence_verified_at, heure d'arrivée
  end
else pas d'adresse e-mail
  E -> W : coche et valide la décharge
  W -> DB : rpc expert_presence_discharge
  DB -> G : notification « présence non vérifiée (décharge) »
end
E -> W : « Commencer le rapport »
W -> DB : rpc expert_start_mandate
DB -> DB : assigned → in_progress, heure d'arrivée
E -> W : pièces, constats, photos,\nétapes non pertinentes, synthèse
W --> E : aperçu du rapport
E -> W : « Envoyer le rapport », puis « Confirmer l'envoi »
loop pour chaque photo
  W -> ST : upload rapports/<mandat>/<pièce>_<n>.jpg
end
W -> DB : rpc expert_send_report(pièces, synthèse,\nétapes non pertinentes)
DB -> DB : INSERT rdf_reports + rdf_report_rooms\nin_progress → waiting_report
DB --> W : id du rapport
W -> PDF : invoke(report_id) avec le JWT
PDF -> DB : lit le rapport (droits de l'appelant)
PDF -> ST : dépose le PDF
PDF --> W : ok (un échec n'annule pas l'envoi)
W --> E : retour à l'accueil
DB -> G : notification « rapport à valider »
G -> DB : clôture le mandat
DB -> DB : waiting_report → closed\n(déclencheur : rapport validé)
@enduml
